[1264.778169, "o", "\t\u001b[32mновый файл:    __fixtures__/jsonFormatResult.txt\u001b[m\r\n\t\u001b[32mизменено:      __tests__/filesCompare.test.js\u001b[m\r\n\t\u001b[32mизменено:      bin/gendiff.js\u001b[m\r\n\t\u001b[32mудалено:       index.js\u001b[m\r\n\t\u001b[32mизменено:      package.json\u001b[m\r\n\t\u001b[32mудалено:       src/cli.js\u001b[m\r\n\t\u001b[32mпереименовано: formatters/index.js -> src/formatters/index.js\u001b[m\r\n\t\u001b[32mпереименовано: formatters/plain.js -> src/formatters/plain.js\u001b[m\r\n\t\u001b[32mпереименовано: formatters/stylish.js -> src/formatters/stylish.js\u001b[m\r\n\t\u001b[32mпереименовано: src/filesCompare.js -> src/index.js\u001b[m\r\n\r\nИзменения, которые не в индексе для коммита:\r\n"]
